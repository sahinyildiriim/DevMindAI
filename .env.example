# DevMind AI - environment template
# Copy to ".env" and adjust. Never commit the real ".env" file.
# Real environment variables always override the values defined here.
# Relative paths are resolved against the project root.

# --- Application ------------------------------------------------------------
DEVMIND_ENV=development
DEVMIND_DEBUG=false

# --- Logging ----------------------------------------------------------------
# Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
DEVMIND_LOG_LEVEL=INFO
DEVMIND_LOG_DIR=logs
DEVMIND_LOG_FILE=devmind.log
DEVMIND_LOG_MAX_BYTES=5242880
DEVMIND_LOG_BACKUP_COUNT=5
DEVMIND_LOG_CONSOLE=true

# --- Database ---------------------------------------------------------------
DEVMIND_DB_PATH=data/db/devmind.db

# --- Microsoft Foundry Local ------------------------------------------------
# Foundry Local serves an OpenAI-compatible endpoint on the loopback interface.
# Verify the active port with: foundry service status
DEVMIND_FOUNDRY_ENDPOINT=http://localhost:5273/v1
# Placeholder value: Foundry Local runs locally and does not authenticate.
DEVMIND_FOUNDRY_API_KEY=foundry-local
DEVMIND_FOUNDRY_CHAT_MODEL=phi-3.5-mini
DEVMIND_FOUNDRY_EMBEDDING_MODEL=all-minilm-l6-v2
DEVMIND_FOUNDRY_TIMEOUT_SECONDS=120
DEVMIND_FOUNDRY_MAX_TOKENS=1024
DEVMIND_FOUNDRY_TEMPERATURE=0.1
# Texts sent per embedding request, and per knowledge base write.
DEVMIND_FOUNDRY_EMBEDDING_BATCH_SIZE=16
DEVMIND_FOUNDRY_MAX_RETRIES=2

# --- Documents --------------------------------------------------------------
DEVMIND_DOCUMENTS_DIR=data/documents
DEVMIND_MAX_FILE_SIZE_MB=25

# --- Retrieval --------------------------------------------------------------
DEVMIND_CHUNK_SIZE=1000
DEVMIND_CHUNK_OVERLAP=150
DEVMIND_TOP_K=5
DEVMIND_MIN_SCORE=0.25
