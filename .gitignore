# --- Secrets ----------------------------------------------------------------
.env
.env.*
!.env.example

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---------------------------------------------------
.venv/
venv/
env/

# --- Tooling caches ---------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- Application data -------------------------------------------------------
# Directory contents are ignored, the directories themselves are kept.
# Note: git cannot re-include a file whose parent directory is ignored,
# so the contents are excluded with a trailing "/*" instead.
*.log
logs/*
!logs/.gitkeep
data/db/*
!data/db/.gitkeep
data/documents/*
!data/documents/.gitkeep

# --- SQLite -----------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# --- Streamlit --------------------------------------------------------------
.streamlit/secrets.toml

# --- Editors and OS ---------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
